# Auto detect text files and normalize line endings to LF across all platforms
* text=auto eol=lf

# Code and configuration files
*.dart text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.cmake text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.swift text eol=lf
*.rc text eol=lf

# Shell scripts must always use LF
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.pdf binary
*.dll binary
*.so binary
*.dylib binary
*.dill binary
*.zip binary
*.tar.gz binary
