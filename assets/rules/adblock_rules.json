{
  "rules_version": "1.0.0",
  "domains": [
    "googlesyndication.com",
    "doubleclick.net",
    "adservice.google.com",
    "adnxs.com",
    "criteo.com",
    "outbrain.com",
    "taboola.com",
    "scorecardresearch.com",
    "adroll.com",
    "pubmatic.com",
    "openx.net",
    "rubiconproject.com",
    "moatads.com",
    "smartadserver.com"
  ],
  "selectors": [
    ".adsbygoogle",
    "ins.adsbygoogle",
    "iframe[src*='doubleclick']",
